{
  "id": "text-statistics",
  "version": "1.0.0",
  "description": "Count Unicode code points, whitespace-delimited words and lines.",
  "mode": "module",
  "instructions": "SKILL.md",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "text": {
        "type": "string",
        "maxLength": 100000
      }
    },
    "required": [
      "text"
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "characters": {
        "type": "integer",
        "minimum": 0
      },
      "words": {
        "type": "integer",
        "minimum": 0
      },
      "lines": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "characters",
      "words",
      "lines"
    ]
  },
  "handler": "handler.js"
}
